<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="egovframework.erp.approval.mapper.ApprovalActionMapper">

    <resultMap id="actionResultMap" type="egovframework.erp.approval.domain.ApprovalActionVO">
        <id property="id" column="id"/>
        <result property="stepId" column="step_id"/>
        <result property="action" column="action"/>
        <result property="comment" column="comment"/>
        <result property="actedAt" column="acted_at"/>
    </resultMap>

    <!-- update/delete 매퍼는 두지 않는다 (append-only, NFR-2-3) -->
    <insert id="insertAction" parameterType="egovframework.erp.approval.domain.ApprovalActionVO">
        INSERT INTO approval_action (step_id, action, comment)
        VALUES (#{stepId}, #{action}, #{comment})
    </insert>

    <select id="selectByStepId" resultMap="actionResultMap">
        SELECT id, step_id, action, comment, acted_at
        FROM approval_action
        WHERE step_id = #{stepId}
    </select>

</mapper>
