<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="egovframework.erp.approval.mapper.ApprovalLineRuleMapper">

    <resultMap id="ruleResultMap" type="egovframework.erp.approval.domain.ApprovalLineRuleVO">
        <id property="id" column="id"/>
        <result property="documentType" column="document_type"/>
        <result property="stepOrder" column="step_order"/>
        <result property="approverLevel" column="approver_level"/>
        <result property="conditionExpr" column="condition_expr"/>
    </resultMap>

    <select id="selectByDocumentType" resultMap="ruleResultMap">
        SELECT id, document_type, step_order, approver_level, condition_expr
        FROM approval_line_rule
        WHERE document_type = #{documentType}
        ORDER BY step_order
    </select>

</mapper>
