<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xsi:schemaLocation="
         http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd
         http://www.springframework.org/schema/context http://www.springframework.org/schema/context/spring-context.xsd">

    <!-- system-properties-mode="ENVIRONMENT"(기본값이지만 명시): db.properties의 값보다
         OS 환경변수/시스템 프로퍼티를 우선 적용해, DB 비밀번호 같은 값을 이 파일에
         하드코딩하지 않고도 배포 환경마다 다르게 주입할 수 있게 한다. -->
    <context:property-placeholder location="classpath:db.properties" system-properties-mode="ENVIRONMENT"/>

    <!-- 도메인/서비스 컴포넌트 스캔 (Controller는 dispatcher-servlet.xml에서 별도 스캔) -->
    <context:component-scan base-package="egovframework.erp">
        <context:exclude-filter type="annotation" expression="org.springframework.stereotype.Controller"/>
    </context:component-scan>

</beans>
