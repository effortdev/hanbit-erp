# 로컬 개발용 환경변수 템플릿.
# 사용법: 이 파일을 .env로 복사하고 실제 값을 채운 뒤 사용하세요.
#   cp .env.example .env
# .env는 .gitignore에 등록되어 있어 커밋되지 않습니다 — 절대 이 파일(.env.example)에
# 실제 비밀번호를 채워서 커밋하지 마세요.

# ── docker-compose.yml (로컬 MySQL 컨테이너) ──────────────────────────────
# docker compose up 실행 시 같은 디렉토리의 .env를 자동으로 읽어 치환합니다.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=hanbit_erp
MYSQL_USER=erp
MYSQL_PASSWORD=

# ── 애플리케이션 DB 접속 정보 (src/main/resources/db.properties가 읽음) ──────
# MYSQL_USER/MYSQL_PASSWORD와 같은 계정으로 접속하므로 보통 위와 동일한 값을 씁니다.
# mvn jetty:run 등 컨테이너 밖에서 앱을 직접 실행할 때는 .env가 자동 로드되지 않으므로,
# 실행 전에 셸에서 값을 불러와야 합니다:
#   set -a && source .env && set +a && mvn jetty:run
JDBC_USERNAME=erp
JDBC_PASSWORD=
